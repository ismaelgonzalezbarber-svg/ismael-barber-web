# Copia este archivo como .env y completa los valores. Nunca publiques .env.
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000
SESSION_SECRET=cambia-esto-por-una-clave-aleatoria-larga-y-unica
ADMIN_USERNAME=ismael
# Genera un hash bcrypt usando las instrucciones del README y pégalo aquí.
ADMIN_PASSWORD_HASH=

# Credenciales OAuth2 de Google Calendar (no las compartas ni las subas a GitHub).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Horario por defecto mostrado en la web. Ajusta estos valores antes de publicar.
TIMEZONE=Europe/Madrid
WHATSAPP_NUMBER=34601240364
